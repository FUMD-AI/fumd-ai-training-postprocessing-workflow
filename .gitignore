# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Generated by run_pipeline.ipynb / individual step notebooks -- OUTPUT_DIR
# is user-configurable (e.g. a separate directory per dataset/hyperparameter
# variant), so this is wildcarded rather than a single fixed name.
pipeline_run*/
migration_maps*/
metrics_comparison*/
executed/
executed_*.ipynb
/out*.ipynb
*.keras
*.joblib

# Slurm job logs (slurm/*.sbatch write here)
logs/
*.out
*.error

# Bring-your-own data this workflow deliberately doesn't bundle (see
# the map-migration-events step's own OSM_PBF_PATH parameter) -- ignored so
# a real run's large OSM extract never gets committed by accident.
*.osm.pbf

# Editor
.vscode/
.idea/
