# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Generated by run_pipeline.ipynb / individual step notebooks -- OUTPUT_DIR
# is user-configurable (e.g. a separate directory per dataset/hyperparameter
# variant), so this is wildcarded rather than a single fixed name.
pipeline_run*/
bs_locations*/
migration_maps*/
metrics_comparison*/
executed/
executed_*.ipynb
/out*.ipynb
*.keras
*.joblib

# Slurm job logs (slurm/*.sbatch write here)
logs/
*.out
*.error

# Bring-your-own data this workflow deliberately doesn't bundle (see
# step_5/step_6's own parameters cells) -- ignored so a real run's large
# real-measurement/OSM files never get committed by accident.
*.osm.pbf
data_cellular*.csv

# Editor
.vscode/
.idea/
